{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "2.3.1",
  "identifier": "com.harshalvankudre.ember-widget",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
